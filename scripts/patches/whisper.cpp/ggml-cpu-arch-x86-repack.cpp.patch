The iOS from-source build (CocoaPods) compiles every source file for all
architecture slices, so arch-specific ggml-cpu sources must be wrapped in arch
guards to avoid duplicate/undefined symbols across slices. (cpu-feats.cpp
already guards itself upstream.)
--- a/ggml/src/ggml-cpu/arch/x86/repack.cpp
+++ b/ggml/src/ggml-cpu/arch/x86/repack.cpp
@@ -1,3 +1,6 @@
+// arch guard (added by scripts/patches/whisper.cpp/ggml-cpu-arch-*.patch)
+#if defined(__x86_64__) || defined(__i386__) || defined(_M_IX86) || defined(_M_X64)
+
 #define GGML_COMMON_IMPL_CPP
 #define GGML_COMMON_DECL_CPP
 #include "ggml-common.h"
@@ -6405,3 +6408,5 @@
 
 #endif
 }
+
+#endif // arch guard
